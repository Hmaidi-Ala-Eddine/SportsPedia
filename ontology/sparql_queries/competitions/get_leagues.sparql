PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?league ?name ?season ?sportDiscipline ?country
WHERE {
    ?league rdf:type sport:League .
    OPTIONAL { ?league sport:hasName ?name }
    OPTIONAL { ?league sport:hasSeason ?season }
    OPTIONAL { ?league sport:forSport ?sportDiscipline }
    OPTIONAL { ?league sport:inCountry ?country }
}
ORDER BY ?name ?season
