PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?match ?homeTeam ?awayTeam ?date ?venue ?score ?competition
WHERE {
    ?match rdf:type sport:Match .
    OPTIONAL { ?match sport:hasHomeTeam ?homeTeam }
    OPTIONAL { ?match sport:hasAwayTeam ?awayTeam }
    OPTIONAL { ?match sport:matchDate ?date }
    OPTIONAL { ?match sport:playedAt ?venue }
    OPTIONAL { ?match sport:finalScore ?score }
    OPTIONAL { ?match sport:partOf ?competition }
}
ORDER BY DESC(?date)
LIMIT 100
