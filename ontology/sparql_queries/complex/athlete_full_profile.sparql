PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT 
    ?athlete ?name ?dateOfBirth ?nationality ?height ?weight
    ?team ?teamName
    ?sportDiscipline ?sportName
    (COUNT(DISTINCT ?record) as ?recordCount)
    (COUNT(DISTINCT ?achievement) as ?achievementCount)
WHERE {
    BIND(sport:{{athlete_id}} as ?athlete)
    
    ?athlete rdf:type sport:Athlete .
    OPTIONAL { ?athlete sport:hasName ?name }
    OPTIONAL { ?athlete sport:dateOfBirth ?dateOfBirth }
    OPTIONAL { ?athlete sport:hasNationality ?nationality }
    OPTIONAL { ?athlete sport:hasHeight ?height }
    OPTIONAL { ?athlete sport:hasWeight ?weight }
    
    OPTIONAL { 
        ?athlete sport:playsFor ?team .
        ?team sport:hasName ?teamName 
    }
    
    OPTIONAL { 
        ?athlete sport:participatesIn ?sportDiscipline .
        ?sportDiscipline sport:hasName ?sportName 
    }
    
    OPTIONAL { ?record sport:setBy ?athlete }
    OPTIONAL { ?achievement sport:achievedBy ?athlete }
}
GROUP BY ?athlete ?name ?dateOfBirth ?nationality ?height ?weight ?team ?teamName ?sportDiscipline ?sportName
