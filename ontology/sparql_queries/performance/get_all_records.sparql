PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?record ?recordType ?value ?athlete ?date ?sportDiscipline
WHERE {
    ?record rdf:type sport:Record .
    OPTIONAL { ?record sport:recordType ?recordType }
    OPTIONAL { ?record sport:recordValue ?value }
    OPTIONAL { ?record sport:setBy ?athlete }
    OPTIONAL { ?record sport:setOn ?date }
    OPTIONAL { ?record sport:inDiscipline ?sportDiscipline }
}
ORDER BY DESC(?date)
