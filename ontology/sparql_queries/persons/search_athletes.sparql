PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?athlete ?name ?nationality ?sportDiscipline
WHERE {
    ?athlete rdf:type sport:Athlete .
    ?athlete sport:hasName ?name .
    
    FILTER(
        CONTAINS(LCASE(?name), LCASE("{{search_term}}")) ||
        CONTAINS(LCASE(STR(?nationality)), LCASE("{{search_term}}"))
    )
    
    OPTIONAL { ?athlete sport:hasNationality ?nationality }
    OPTIONAL { ?athlete sport:participatesIn ?sportDiscipline }
}
ORDER BY ?name
LIMIT 50
