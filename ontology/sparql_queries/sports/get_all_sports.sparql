PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?sportDiscipline ?name ?category ?isOlympic
WHERE {
    ?sportDiscipline rdf:type sport:SportDiscipline .
    OPTIONAL { ?sportDiscipline sport:hasName ?name }
    OPTIONAL { ?sportDiscipline rdf:type ?category }
    OPTIONAL { ?sportDiscipline sport:isOlympicSport ?isOlympic }
}
ORDER BY ?name
