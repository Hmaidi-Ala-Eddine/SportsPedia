PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?sport ?name ?teamSize ?isOlympic
WHERE {
    ?sport rdf:type sport:TeamSport .
    OPTIONAL { ?sport sport:hasName ?name }
    OPTIONAL { ?sport sport:typicalTeamSize ?teamSize }
    OPTIONAL { ?sport sport:isOlympicSport ?isOlympic }
}
ORDER BY ?name
