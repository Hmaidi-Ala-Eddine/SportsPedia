PREFIX sport: <http://example.org/sports-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?venue ?name ?location ?capacity ?openedYear ?surface ?homeTeam
WHERE {
    ?venue rdf:type sport:Venue .
    FILTER(?venue = sport:{{venue_id}})
    
    OPTIONAL { ?venue sport:hasName ?name }
    OPTIONAL { ?venue sport:locatedIn ?location }
    OPTIONAL { ?venue sport:hasCapacity ?capacity }
    OPTIONAL { ?venue sport:openedYear ?openedYear }
    OPTIONAL { ?venue sport:hasSurface ?surface }
    OPTIONAL { ?team sport:hasHomeVenue ?venue . BIND(?team as ?homeTeam) }
}
