  <rdf:Description rdf:about="http://example.org/sports-ontology#LaLigaOrg">
    <rdf:type rdf:resource="http://example.org/sports-ontology#League_Org" />
    <sport:organizationName>La Liga (Liga Nacional de Fútbol Profesional)</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1984</sport:establishedYear>
    <sport:headquarters>Madrid, Spain</sport:headquarters>
    <sport:president>Javier Tebas</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42</sport:memberCount>
    <sport:description>La Liga manages Spain's professional football leagues. Known for technical excellence and global superstars, La Liga broadcasts to 183 countries. The organization has modernized Spanish football's commercial operations.</sport:description>
    <sport:jurisdiction>Spain</sport:jurisdiction>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">4500.0</sport:annualRevenue>
    <sport:manages>La Liga, Segunda División</sport:manages>
    <sport:broadcastCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">183</sport:broadcastCountries>
  </rdf:Description>
