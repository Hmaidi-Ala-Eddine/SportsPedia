<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:sport="http://example.org/sports-ontology#"
         xml:base="http://example.org/sports-ontology#">

  <owl:Ontology rdf:about="http://example.org/sports-ontology">
    <rdfs:label xml:lang="en">Comprehensive Sports Encyclopedia Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">A comprehensive ontology for modeling sports with exactly 10 main classes, extensive hierarchies, properties, and real-world individuals.</rdfs:comment>
    <owl:versionInfo>2.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ===================== 10 MAIN CLASSES WITH HIERARCHIES ===================== -->
  
  <!-- 1. SPORT DISCIPLINE CLASS -->
  <owl:Class rdf:about="#SportDiscipline">
    <rdfs:label xml:lang="en">Sport Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all types of sports and athletic disciplines</rdfs:comment>
  </owl:Class>
  
  <!-- Sport Discipline Subclasses -->
  <owl:Class rdf:about="#TeamSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Team Sport</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#IndividualSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Individual Sport</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#CombatSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Combat Sport</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#WaterSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Water Sport</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#WinterSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Winter Sport</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#MotorSport">
    <rdfs:subClassOf rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">Motor Sport</rdfs:label>
  </owl:Class>
  
  <!-- 2. PERSON CLASS -->
  <owl:Class rdf:about="#Person">
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all people involved in sports</rdfs:comment>
  </owl:Class>
  
  <!-- Person Subclasses -->
  <owl:Class rdf:about="#Athlete">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Athlete</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Coach">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Coach</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Referee">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Referee</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#SportsMedical">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Sports Medical Staff</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#SportsJournalist">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Sports Journalist</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#SportsAgent">
    <rdfs:subClassOf rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">Sports Agent</rdfs:label>
  </owl:Class>
  
  <!-- 3. TEAM CLASS -->
  <owl:Class rdf:about="#Team">
    <rdfs:label xml:lang="en">Team</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing sports teams and clubs</rdfs:comment>
  </owl:Class>
  
  <!-- Team Subclasses -->
  <owl:Class rdf:about="#ProfessionalTeam">
    <rdfs:subClassOf rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">Professional Team</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#AmateurTeam">
    <rdfs:subClassOf rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">Amateur Team</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#NationalTeam">
    <rdfs:subClassOf rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">National Team</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#YouthTeam">
    <rdfs:subClassOf rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">Youth Team</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#WomenTeam">
    <rdfs:subClassOf rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">Women Team</rdfs:label>
  </owl:Class>
  
  <!-- 4. COMPETITION CLASS -->
  <owl:Class rdf:about="#Competition">
    <rdfs:label xml:lang="en">Competition</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all types of sports competitions and events</rdfs:comment>
  </owl:Class>
  
  <!-- Competition Subclasses -->
  <owl:Class rdf:about="#League">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">League</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Tournament">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">Tournament</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Championship">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">Championship</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Olympics">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">Olympics</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#WorldCup">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">World Cup</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Match">
    <rdfs:subClassOf rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">Match</rdfs:label>
  </owl:Class>
  
  <!-- 5. VENUE CLASS -->
  <owl:Class rdf:about="#Venue">
    <rdfs:label xml:lang="en">Venue</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all sports venues and facilities</rdfs:comment>
  </owl:Class>
  
  <!-- Venue Subclasses -->
  <owl:Class rdf:about="#Stadium">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Stadium</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Arena">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Arena</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Court">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Court</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Track">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Track</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Pool">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Pool</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#GolfCourse">
    <rdfs:subClassOf rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">Golf Course</rdfs:label>
  </owl:Class>
  
  <!-- 6. ORGANIZATION CLASS -->
  <owl:Class rdf:about="#Organization">
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all sports organizations and governing bodies</rdfs:comment>
  </owl:Class>
  
  <!-- Organization Subclasses -->
  <owl:Class rdf:about="#Federation">
    <rdfs:subClassOf rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">Federation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Club">
    <rdfs:subClassOf rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">Club</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#League_Org">
    <rdfs:subClassOf rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">League Organization</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#SportsAgency">
    <rdfs:subClassOf rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">Sports Agency</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#AntiDoping">
    <rdfs:subClassOf rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">Anti-Doping Agency</rdfs:label>
  </owl:Class>
  
  <!-- 7. EQUIPMENT CLASS -->
  <owl:Class rdf:about="#Equipment">
    <rdfs:label xml:lang="en">Equipment</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all sports equipment and gear</rdfs:comment>
  </owl:Class>
  
  <!-- Equipment Subclasses -->
  <owl:Class rdf:about="#ProtectiveGear">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label xml:lang="en">Protective Gear</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#PlayingEquipment">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label xml:lang="en">Playing Equipment</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Apparel">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label xml:lang="en">Apparel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Footwear">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label xml:lang="en">Footwear</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#TrainingEquipment">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label xml:lang="en">Training Equipment</rdfs:label>
  </owl:Class>
  
  <!-- 8. PERFORMANCE CLASS -->
  <owl:Class rdf:about="#Performance">
    <rdfs:label xml:lang="en">Performance</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all types of sports performance and statistics</rdfs:comment>
  </owl:Class>
  
  <!-- Performance Subclasses -->
  <owl:Class rdf:about="#Record">
    <rdfs:subClassOf rdf:resource="#Performance"/>
    <rdfs:label xml:lang="en">Record</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Statistic">
    <rdfs:subClassOf rdf:resource="#Performance"/>
    <rdfs:label xml:lang="en">Statistic</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Ranking">
    <rdfs:subClassOf rdf:resource="#Performance"/>
    <rdfs:label xml:lang="en">Ranking</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Achievement">
    <rdfs:subClassOf rdf:resource="#Performance"/>
    <rdfs:label xml:lang="en">Achievement</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Measurement">
    <rdfs:subClassOf rdf:resource="#Performance"/>
    <rdfs:label xml:lang="en">Measurement</rdfs:label>
  </owl:Class>
  
  <!-- 9. MEDIA CLASS -->
  <owl:Class rdf:about="#Media">
    <rdfs:label xml:lang="en">Media</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all types of sports media and broadcasting</rdfs:comment>
  </owl:Class>
  
  <!-- Media Subclasses -->
  <owl:Class rdf:about="#Television">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Television</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Radio">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Radio</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#PrintMedia">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Print Media</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#DigitalMedia">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Digital Media</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#SocialMedia">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Social Media</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#StreamingPlatform">
    <rdfs:subClassOf rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">Streaming Platform</rdfs:label>
  </owl:Class>
  
  <!-- 10. SPONSORSHIP CLASS -->
  <owl:Class rdf:about="#Sponsorship">
    <rdfs:label xml:lang="en">Sponsorship</rdfs:label>
    <rdfs:comment xml:lang="en">Main class representing all types of sports sponsorship and commercial partnerships</rdfs:comment>
  </owl:Class>
  
  <!-- Sponsorship Subclasses -->
  <owl:Class rdf:about="#TitleSponsor">
    <rdfs:subClassOf rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">Title Sponsor</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#OfficialSponsor">
    <rdfs:subClassOf rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">Official Sponsor</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#TechnicalSponsor">
    <rdfs:subClassOf rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">Technical Sponsor</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#NamingRights">
    <rdfs:subClassOf rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">Naming Rights</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="#Endorsement">
    <rdfs:subClassOf rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">Endorsement</rdfs:label>
  </owl:Class>

  <!-- ===================== OBJECT PROPERTIES ===================== -->
  
  <!-- Person-related Object Properties -->
  <owl:ObjectProperty rdf:about="#playsFor">
    <rdfs:domain rdf:resource="#Athlete"/>
    <rdfs:range rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">plays for</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#practicesSport">
    <rdfs:domain rdf:resource="#Athlete"/>
    <rdfs:range rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">practices sport</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#coaches">
    <rdfs:domain rdf:resource="#Coach"/>
    <rdfs:range rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">coaches</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#coachesAthlete">
    <rdfs:domain rdf:resource="#Coach"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">coaches athlete</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#refereesMatch">
    <rdfs:domain rdf:resource="#Referee"/>
    <rdfs:range rdf:resource="#Match"/>
    <rdfs:label xml:lang="en">referees match</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#treatsAthlete">
    <rdfs:domain rdf:resource="#SportsMedical"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">treats athlete</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#representsAthlete">
    <rdfs:domain rdf:resource="#SportsAgent"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">represents athlete</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Team-related Object Properties -->
  <owl:ObjectProperty rdf:about="#competesIn">
    <rdfs:domain rdf:resource="#Team"/>
    <rdfs:range rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">competes in</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#homeVenue">
    <rdfs:domain rdf:resource="#Team"/>
    <rdfs:range rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">home venue</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#sponsoredBy">
    <rdfs:domain rdf:resource="#Team"/>
    <rdfs:range rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">sponsored by</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#memberOf">
    <rdfs:domain rdf:resource="#Team"/>
    <rdfs:range rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">member of</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Competition-related Object Properties -->
  <owl:ObjectProperty rdf:about="#takesPlaceAt">
    <rdfs:domain rdf:resource="#Competition"/>
    <rdfs:range rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">takes place at</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#organizedBy">
    <rdfs:domain rdf:resource="#Competition"/>
    <rdfs:range rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">organized by</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#featuresTeam">
    <rdfs:domain rdf:resource="#Competition"/>
    <rdfs:range rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">features team</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#broadcastBy">
    <rdfs:domain rdf:resource="#Competition"/>
    <rdfs:range rdf:resource="#Media"/>
    <rdfs:label xml:lang="en">broadcast by</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Venue-related Object Properties -->
  <owl:ObjectProperty rdf:about="#hostsEvent">
    <rdfs:domain rdf:resource="#Venue"/>
    <rdfs:range rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">hosts event</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#ownedBy">
    <rdfs:domain rdf:resource="#Venue"/>
    <rdfs:range rdf:resource="#Organization"/>
    <rdfs:label xml:lang="en">owned by</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#suitableFor">
    <rdfs:domain rdf:resource="#Venue"/>
    <rdfs:range rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">suitable for</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Equipment-related Object Properties -->
  <owl:ObjectProperty rdf:about="#usedBy">
    <rdfs:domain rdf:resource="#Equipment"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">used by</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#requiredFor">
    <rdfs:domain rdf:resource="#Equipment"/>
    <rdfs:range rdf:resource="#SportDiscipline"/>
    <rdfs:label xml:lang="en">required for</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#providedBy">
    <rdfs:domain rdf:resource="#Equipment"/>
    <rdfs:range rdf:resource="#Sponsorship"/>
    <rdfs:label xml:lang="en">provided by</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Performance-related Object Properties -->
  <owl:ObjectProperty rdf:about="#achievedBy">
    <rdfs:domain rdf:resource="#Performance"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">achieved by</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#recordedIn">
    <rdfs:domain rdf:resource="#Performance"/>
    <rdfs:range rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">recorded in</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#measuredAt">
    <rdfs:domain rdf:resource="#Performance"/>
    <rdfs:range rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">measured at</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Media-related Object Properties -->
  <owl:ObjectProperty rdf:about="#covers">
    <rdfs:domain rdf:resource="#Media"/>
    <rdfs:range rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">covers</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#interviews">
    <rdfs:domain rdf:resource="#Media"/>
    <rdfs:range rdf:resource="#Person"/>
    <rdfs:label xml:lang="en">interviews</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#partnersWithTeam">
    <rdfs:domain rdf:resource="#Media"/>
    <rdfs:range rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">partners with team</rdfs:label>
  </owl:ObjectProperty>
  
  <!-- Sponsorship-related Object Properties -->
  <owl:ObjectProperty rdf:about="#sponsors">
    <rdfs:domain rdf:resource="#Sponsorship"/>
    <rdfs:range rdf:resource="#Team"/>
    <rdfs:label xml:lang="en">sponsors</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#endorses">
    <rdfs:domain rdf:resource="#Sponsorship"/>
    <rdfs:range rdf:resource="#Athlete"/>
    <rdfs:label xml:lang="en">endorses</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#sponsorsEvent">
    <rdfs:domain rdf:resource="#Sponsorship"/>
    <rdfs:range rdf:resource="#Competition"/>
    <rdfs:label xml:lang="en">sponsors event</rdfs:label>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="#hasNamingRights">
    <rdfs:domain rdf:resource="#Sponsorship"/>
    <rdfs:range rdf:resource="#Venue"/>
    <rdfs:label xml:lang="en">has naming rights</rdfs:label>
  </owl:ObjectProperty>
  <!-- ===================== DATA PROPERTIES ===================== -->
  
  <!-- Person Data Properties -->
  <owl:DatatypeProperty rdf:about="#firstName">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">first name</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#lastName">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">last name</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#birthDate">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">birth date</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#nationality">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">nationality</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#height">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">height in cm</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#weight">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">weight in kg</rdfs:label>
  </owl:DatatypeProperty>
  
  <owl:DatatypeProperty rdf:about="#gender">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">gender</rdfs:label>
  </owl:DatatypeProperty>
  
  <!-- Athlete-specific Data Properties -->
  <owl:DatatypeProperty rdf:about="#jerseyNumber">
