    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://example.org/sports-ontology#Venue" />
    <rdfs:label xml:lang="en">Stadium</rdfs:label>
  </rdf:Description>
