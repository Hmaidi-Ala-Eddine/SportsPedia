    <sport:president>Donata Hopfen</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</sport:memberCount>
    <sport:description>The DFL operates the Bundesliga and 2. Bundesliga. German football emphasizes fan culture, affordable tickets, and the 50+1 ownership rule protecting fan interests. Bundesliga's attacking football and stadium atmosphere are world-renowned.</sport:description>
    <sport:jurisdiction>Germany</sport:jurisdiction>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">4200.0</sport:annualRevenue>
    <sport:manages>Bundesliga, 2. Bundesliga</sport:manages>
    <sport:uniqueFeature>50+1 ownership rule</sport:uniqueFeature>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#ClementTurpin">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Referee" />
    <sport:firstName>Clement</sport:firstName>
    <sport:lastName>Turpin</sport:lastName>
    <sport:nationality>France</sport:nationality>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</sport:experienceYears>
    <sport:matchesOfficiated rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250</sport:matchesOfficiated>
    <sport:level>International</sport:level>
    <sport:description>France's leading referee and one of UEFA's elite officials. Clement Turpin has been selected for major tournament finals including the 2022 World Cup. His modern approach to refereeing balances strict rule enforcement with understanding of game flow. Known for his fitness, clear communication, and ability to use VAR effectively, he represents the new generation of top-level referees.</sport:description>
    <sport:expertise>Modern refereeing approach, Technology integration (VAR), Clear communication, Fitness, Progressive officiating</sport:expertise>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#BjornKuipers">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Referee" />
    <sport:firstName>Bjorn</sport:firstName>
    <sport:lastName>Kuipers</sport:lastName>
