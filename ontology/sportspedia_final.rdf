  <rdf:Description rdf:about="http://example.org/sports-ontology#RobertLewandowski">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Athlete" />
    <sport:firstName>Robert</sport:firstName>
    <sport:lastName>Lewandowski</sport:lastName>
    <sport:nationality>Poland</sport:nationality>
    <sport:position>Forward</sport:position>
    <sport:practicesSport rdf:resource="http://example.org/sports-ontology#Football" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#DiegoSimeone">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Coach" />
    <sport:firstName>Diego</sport:firstName>
    <sport:lastName>Simeone</sport:lastName>
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1970-04-28</sport:birthDate>
    <sport:nationality>Argentina</sport:nationality>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</sport:experienceYears>
    <sport:titlesWon rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</sport:titlesWon>
    <sport:coachingStyle>Defensive</sport:coachingStyle>
    <sport:description>The Argentine firebrand known for his intense, defensive tactical approach. Simeone transformed Atletico Madrid into a powerhouse, breaking the Barcelona-Real Madrid duopoly in La Liga. His teams are known for their incredible work ethic, defensive solidity, and never-say-die attitude. His passionate touchline presence and warrior mentality inspire total commitment from his players.</sport:description>
    <sport:philosophy>Defensive solidity, Counter-attacking, High work rate, Mental resilience, Warrior mentality</sport:philosophy>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#OfficialSponsor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:subClassOf rdf:resource="http://example.org/sports-ontology#Sponsorship" />
    <rdfs:label xml:lang="en">Official Sponsor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#WorldRugby">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Federation" />
    <sport:organizationName>World Rugby</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1886</sport:establishedYear>
    <sport:headquarters>Dublin, Ireland</sport:headquarters>
    <sport:president>Bill Beaumont</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">130</sport:memberCount>
    <sport:description>World Rugby governs rugby union, organizing the Rugby World Cup. The sport combines physicality, strategy, and sportsmanship. Rugby's values of respect, integrity, and passion define its culture globally.</sport:description>
    <sport:jurisdiction>Worldwide</sport:jurisdiction>
    <sport:organizes>Rugby World Cup, Six Nations, Rugby Championship</sport:organizes>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">180.0</sport:annualRevenue>
  </rdf:Description>
