  <rdf:Description rdf:about="http://example.org/sports-ontology#Chelsea">
    <rdf:type rdf:resource="http://example.org/sports-ontology#ProfessionalTeam" />
    <sport:teamName>Chelsea FC</sport:teamName>
    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1905</sport:foundedYear>
    <sport:primaryColor>Blue</sport:primaryColor>
    <sport:secondaryColor>White</sport:secondaryColor>
    <sport:squadSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</sport:squadSize>
    <sport:budget rdf:datatype="http://www.w3.org/2001/XMLSchema#float">580.0</sport:budget>
    <sport:currentRanking rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</sport:currentRanking>
    <sport:wins rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520</sport:wins>
    <sport:losses rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">195</sport:losses>
    <sport:draws rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">285</sport:draws>
    <sport:homeVenue>Stamford Bridge</sport:homeVenue>
    <sport:city>London</sport:city>
    <sport:country>England</sport:country>
    <sport:description>London-based club transformed into European powerhouse since 2003. Chelsea has won multiple Premier League titles and Champions League trophies. Known for their strong defense and ability to attract world-class talent.</sport:description>
    <sport:majorAchievements>6 League Titles, 8 FA Cups, 2 Champions Leagues, 2 Europa Leagues</sport:majorAchievements>
    <sport:estimatedFans rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58000000</sport:estimatedFans>
    <sport:rivals>Arsenal, Tottenham, Fulham</sport:rivals>
  </rdf:Description>
