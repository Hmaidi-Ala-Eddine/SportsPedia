  <sport:Referee rdf:about="#ClementTurpin">
    <sport:firstName>Clement</sport:firstName>
    <sport:lastName>Turpin</sport:lastName>
    <sport:nationality>France</sport:nationality>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</sport:experienceYears>
    <sport:matchesOfficiated rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250</sport:matchesOfficiated>
    <sport:level>International</sport:level>
    <sport:description>France's leading referee and one of UEFA's elite officials. Clement Turpin has been selected for major tournament finals including the 2022 World Cup. His modern approach to refereeing balances strict rule enforcement with understanding of game flow. Known for his fitness, clear communication, and ability to use VAR effectively, he represents the new generation of top-level referees.</sport:description>
    <sport:expertise>Modern refereeing approach, Technology integration (VAR), Clear communication, Fitness, Progressive officiating</sport:expertise>
  </sport:Referee>

  
