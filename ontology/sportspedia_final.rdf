    <sport:numberOfTeams rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</sport:numberOfTeams>
    <sport:season>2026</sport:season>
    <sport:season xml:lang="en">2026</sport:season>
    <sport:prizeMoney rdf:datatype="http://www.w3.org/2001/XMLSchema#float">600.0</sport:prizeMoney>
    <sport:prizeMoney rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">440</sport:prizeMoney>
    <sport:country>USA, Canada, Mexico</sport:country>
    <sport:country xml:lang="en">USA, Canada, Mexico</sport:country>
    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1930</sport:foundedYear>
    <sport:description>The pinnacle of international football held every four years. The 2026 World Cup will be the first with 48 teams, hosted across three North American nations. The tournament unites the world through the beautiful game.</sport:description>
    <sport:description xml:lang="en">The 23rd FIFA World Cup with expanded format</sport:description>
    <sport:broadcastCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">250</sport:broadcastCountries>
    <sport:competitionFormat>Group stage followed by knockout rounds</sport:competitionFormat>
    <sport:competitionFormat xml:lang="en">Group Stage + Knockout</sport:competitionFormat>
    <sport:lastWinner>Argentina (2022)</sport:lastWinner>
