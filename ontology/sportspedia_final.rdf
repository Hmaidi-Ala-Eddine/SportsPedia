    <rdf:type rdf:resource="http://example.org/sports-ontology#NamingRights" />
    <sport:sponsorName>Crypto.com</sport:sponsorName>
    <sport:dealValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">700.0</sport:dealValue>
    <sport:contractDuration rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</sport:contractDuration>
    <sport:industry>Cryptocurrency</sport:industry>
    <sport:hasNamingRights rdf:resource="http://example.org/sports-ontology#CryptoComArena" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#LionelMessi">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Athlete" />
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1987-06-24</sport:birthDate>
    <sport:height rdf:datatype="http://www.w3.org/2001/XMLSchema#float">170.0</sport:height>
    <sport:weight rdf:datatype="http://www.w3.org/2001/XMLSchema#float">72.0</sport:weight>
    <sport:gender>Male</sport:gender>
    <sport:marketValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">50.0</sport:marketValue>
    <sport:salary rdf:datatype="http://www.w3.org/2001/XMLSchema#float">50000000.0</sport:salary>
    <sport:isCaptain rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sport:isCaptain>
    <sport:description>Widely regarded as one of the greatest footballers of all time, Lionel Messi has won a record eight Ballon d'Or awards. The Argentine captain led his nation to World Cup glory in 2022, cementing his legacy as a complete player. Known for his dribbling, vision, and goal-scoring prowess, Messi spent over two decades at Barcelona before joining Paris Saint-Germain and later Inter Miami.</sport:description>
    <sport:achievements>8x Ballon d'Or, 2022 World Cup Winner, 4x Champions League Winner, 10x La Liga Champion</sport:achievements>
    <sport:specialties>Dribbling, Free-kicks, Playmaking, Goal-scoring</sport:specialties>
    <sport:playsFor rdf:resource="http://example.org/sports-ontology#InterMiami" />
    <sport:practicesSport rdf:resource="http://example.org/sports-ontology#Football" />
    <sport:firstName>Lionel</sport:firstName>
    <sport:lastName>Messi</sport:lastName>
    <sport:nationality>Argentina</sport:nationality>
    <sport:jerseyNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</sport:jerseyNumber>
    <sport:position>Forward</sport:position>
    <sport:goalsScored rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">806</sport:goalsScored>
    <sport:assists rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">357</sport:assists>
    <sport:matchesPlayed rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1003</sport:matchesPlayed>
  </rdf:Description>
