    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1971</sport:foundedYear>
    <sport:description>UEFA's secondary club competition offering a pathway to Champions League qualification. The Europa League features competitive matches and has become increasingly prestigious with top clubs participating.</sport:description>
