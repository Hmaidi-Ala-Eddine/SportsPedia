  <rdf:Description rdf:about="http://example.org/sports-ontology#FelixBrych">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Referee" />
    <sport:firstName>Felix</sport:firstName>
    <sport:lastName>Brych</sport:lastName>
    <sport:nationality>Germany</sport:nationality>
    <sport:level>International</sport:level>
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1975-08-03</sport:birthDate>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</sport:experienceYears>
    <sport:matchesOfficiated rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">402</sport:matchesOfficiated>
    <sport:description>Germany's most prominent referee and a lawyer by profession. Felix Brych has officiated multiple Champions League finals and major international tournaments. His calm authority, legal precision in decision-making, and deep understanding of the game have made him one of UEFA's most trusted officials. He consistently handles the biggest matches in European football with confidence and fairness.</sport:description>
    <sport:expertise>Game management, Legal precision in decisions, Experience in top-level matches, Calm authority, Fair play enforcement</sport:expertise>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#ICC">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Federation" />
    <sport:organizationName>International Cricket Council</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1909</sport:establishedYear>
    <sport:headquarters>Dubai, UAE</sport:headquarters>
    <sport:president>Greg Barclay</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">108</sport:memberCount>
    <sport:description>ICC governs cricket globally, organizing World Cups across three formats. Cricket's popularity in South Asia makes it the world's second-most watched sport. The ICC balances traditional cricket powers with growing cricket nations.</sport:description>
    <sport:jurisdiction>Worldwide</sport:jurisdiction>
    <sport:organizes>ICC Cricket World Cup, T20 World Cup, Champions Trophy</sport:organizes>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">650.0</sport:annualRevenue>
  </rdf:Description>
