    <sport:matchesOfficiated rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">387</sport:matchesOfficiated>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#NBAOrg">
    <rdf:type rdf:resource="http://example.org/sports-ontology#League_Org" />
    <sport:organizationName>National Basketball Association</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1946</sport:establishedYear>
    <sport:headquarters>New York City, United States</sport:headquarters>
    <sport:president>Adam Silver (Commissioner)</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</sport:memberCount>
    <sport:description>The NBA is basketball's premier professional league. The organization has revolutionized sports marketing, making basketball a global phenomenon. NBA stars are cultural icons, and the league's innovation influences sports worldwide.</sport:description>
    <sport:jurisdiction>United States, Canada</sport:jurisdiction>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10500.0</sport:annualRevenue>
    <sport:manages>NBA Regular Season, NBA Playoffs</sport:manages>
    <sport:salaryCap rdf:datatype="http://www.w3.org/2001/XMLSchema#float">136.0</sport:salaryCap>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#HowardWebb">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Referee" />
    <sport:firstName>Howard</sport:firstName>
    <sport:lastName>Webb</sport:lastName>
    <sport:nationality>United Kingdom</sport:nationality>
    <sport:nationality>England</sport:nationality>
    <sport:level>International</sport:level>
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1971-07-14</sport:birthDate>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</sport:experienceYears>
    <sport:matchesOfficiated rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">315</sport:matchesOfficiated>
    <sport:description>The English referee who officiated both the 2010 World Cup Final and Champions League Final in the same year—a unique achievement in refereeing history. Webb was known for his calm demeanor, excellent communication with players, and ability to manage high-stakes matches. He retired as one of the most respected officials in world football and now serves as Chief Refereeing Officer for the Premier League.</sport:description>
    <sport:expertise>High-pressure situations, Player management, Consistent decision-making, Communication, Big-match temperament</sport:expertise>
  </rdf:Description>
