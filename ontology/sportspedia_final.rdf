    <rdf:type rdf:resource="http://example.org/sports-ontology#Championship" />
    <sport:organizedBy rdf:resource="http://example.org/sports-ontology#UEFA" />
    <sport:competitionName>UEFA Champions League</sport:competitionName>
    <sport:numberOfTeams rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</sport:numberOfTeams>
    <sport:season>2023-24</sport:season>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#ZinedineZidane">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Coach" />
    <sport:firstName>Zinedine</sport:firstName>
    <sport:lastName>Zidane</sport:lastName>
    <sport:nationality>France</sport:nationality>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</sport:experienceYears>
    <sport:experienceYears rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</sport:experienceYears>
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1972-06-23</sport:birthDate>
    <sport:titlesWon rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</sport:titlesWon>
    <sport:coachingStyle>Counter-attacking</sport:coachingStyle>
    <sport:description>A legendary player turned legendary coach, Zidane won three consecutive Champions League titles with Real Madrid—a feat unmatched in the modern era. His calm presence, tactical acumen, and ability to manage one of football's most star-studded squads demonstrated his natural leadership. As both player and coach, Zidane represents football excellence at its highest level.</sport:description>
    <sport:philosophy>Counter-attacking football, Player empowerment, Rotation management, Tactical adaptability, Star management</sport:philosophy>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#MbappeWorldCup">
