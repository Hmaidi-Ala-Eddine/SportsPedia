    <sport:country>England</sport:country>
    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1871</sport:foundedYear>
    <sport:description>The world's oldest football competition featuring giant-killings and magical moments. The FA Cup is a cherished tradition where non-league teams can face Premier League giants. The competition embodies the romance of cup football.</sport:description>
    <sport:broadcastCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</sport:broadcastCountries>
    <sport:competitionFormat>Single-elimination knockout</sport:competitionFormat>
    <sport:venue>Wembley Stadium (Final)</sport:venue>
  </rdf:Description>
