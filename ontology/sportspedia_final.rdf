  <rdf:Description rdf:about="http://example.org/sports-ontology#FACup">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Championship" />
    <sport:competitionName>FA Cup</sport:competitionName>
    <sport:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-10</sport:startDate>
    <sport:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-17</sport:endDate>
