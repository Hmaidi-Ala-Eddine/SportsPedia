  <rdf:Description rdf:about="http://example.org/sports-ontology#ReloSports">
    <rdf:type rdf:resource="http://example.org/sports-ontology#SportsAgency" />
    <sport:organizationName>Relo Sports &amp; Entertainment</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2015</sport:establishedYear>
    <sport:headquarters>Madrid, Spain</sport:headquarters>
    <sport:president>Fabio Pinto</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</sport:memberCount>
    <sport:description>Rapidly growing sports agency specializing in football. Relo Sports represents emerging talents and established stars, particularly from South America and Europe. The agency's innovative approach to digital branding sets it apart.</sport:description>
    <sport:jurisdiction>Europe, South America</sport:jurisdiction>
    <sport:sportsManaged>Football (Soccer)</sport:sportsManaged>
    <sport:servicesOffered>Player representation, transfer negotiations, brand management</sport:servicesOffered>
    <sport:notableAspect>Strong South American network</sport:notableAspect>
  </rdf:Description>
