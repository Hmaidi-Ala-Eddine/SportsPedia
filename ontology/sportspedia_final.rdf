    <sport:achievementType>FIFA World Cup Winner</sport:achievementType>
    <sport:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2018</sport:year>
    <sport:achievedBy rdf:resource="http://example.org/sports-ontology#KylianMbappe" />
  </rdf:Description>
