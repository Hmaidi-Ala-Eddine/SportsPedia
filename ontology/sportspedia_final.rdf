    <sport:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-10</sport:startDate>
    <sport:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-13</sport:endDate>
