  <rdf:Description rdf:about="http://example.org/sports-ontology#CristianoRonaldo">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Athlete" />
    <sport:firstName>Cristiano</sport:firstName>
    <sport:lastName>Ronaldo</sport:lastName>
    <sport:birthDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1985-02-05</sport:birthDate>
    <sport:nationality>Portugal</sport:nationality>
    <sport:height rdf:datatype="http://www.w3.org/2001/XMLSchema#float">187.0</sport:height>
    <sport:weight rdf:datatype="http://www.w3.org/2001/XMLSchema#float">84.0</sport:weight>
    <sport:gender>Male</sport:gender>
    <sport:jerseyNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</sport:jerseyNumber>
    <sport:position>Forward</sport:position>
    <sport:marketValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</sport:marketValue>
    <sport:goalsScored rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">890</sport:goalsScored>
    <sport:assists rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">245</sport:assists>
    <sport:matchesPlayed rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1200</sport:matchesPlayed>
    <sport:description>A five-time Ballon d'Or winner and one of the most prolific goalscorers in football history with over 890 career goals. Ronaldo has conquered multiple leagues including the Premier League, La Liga, and Serie A. Known for his athleticism, heading ability, and incredible work ethic, he continues to break records well into his late thirties. His dedication to fitness and relentless pursuit of excellence have made him a global icon.</sport:description>
    <sport:achievements>5x Ballon d'Or, 5x Champions League Winner, Euro 2016 Champion, Multiple League Titles across England, Spain, and Italy</sport:achievements>
    <sport:specialties>Heading, Long-range Shots, Speed, Aerial Ability, Penalty-taking</sport:specialties>
    <sport:playsFor rdf:resource="http://example.org/sports-ontology#AlNassr" />
    <sport:practicesSport rdf:resource="http://example.org/sports-ontology#Football" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#HarryKane">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Athlete" />
    <sport:firstName>Harry</sport:firstName>
    <sport:lastName>Kane</sport:lastName>
    <sport:nationality>England</sport:nationality>
    <sport:position>Forward</sport:position>
    <sport:practicesSport rdf:resource="http://example.org/sports-ontology#Football" />
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:domain rdf:resource="http://example.org/sports-ontology#Equipment" />
