  <rdf:Description rdf:about="http://example.org/sports-ontology#ManchesterUnited">
    <rdf:type rdf:resource="http://example.org/sports-ontology#ProfessionalTeam" />
    <sport:teamName>Manchester United FC</sport:teamName>
    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1878</sport:foundedYear>
    <sport:primaryColor>Red</sport:primaryColor>
    <sport:secondaryColor>White</sport:secondaryColor>
    <sport:squadSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</sport:squadSize>
    <sport:budget rdf:datatype="http://www.w3.org/2001/XMLSchema#float">650.0</sport:budget>
    <sport:currentRanking rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</sport:currentRanking>
    <sport:wins rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">580</sport:wins>
    <sport:losses rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">180</sport:losses>
    <sport:draws rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">240</sport:draws>
    <sport:homeVenue>Old Trafford</sport:homeVenue>
    <sport:city>Manchester</sport:city>
    <sport:country>England</sport:country>
    <sport:description>One of the most successful and widely supported clubs in world football. Known as the Red Devils, Manchester United has won 20 English league titles and 3 UEFA Champions League trophies. The club's history includes legendary players like George Best, Bobby Charlton, Eric Cantona, David Beckham, and Cristiano Ronaldo.</sport:description>
    <sport:majorAchievements>20 League Titles, 12 FA Cups, 3 Champions Leagues, 1 Club World Cup</sport:majorAchievements>
    <sport:estimatedFans rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">75000000</sport:estimatedFans>
    <sport:rivals>Liverpool, Manchester City, Leeds United</sport:rivals>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#RealMadridClub">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Club" />
    <sport:organizationName>Real Madrid CF</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1902</sport:establishedYear>
    <sport:headquarters>Madrid, Spain</sport:headquarters>
    <sport:president>Florentino Pérez</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95000</sport:memberCount>
    <sport:description>The most successful club in European football history with 14 Champions League titles. Real Madrid embodies 'Los Blancos' winning mentality and Galácticos star power. The club's prestige attracts the world's best players.</sport:description>
    <sport:jurisdiction>Madrid, Spain</sport:jurisdiction>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">830.0</sport:annualRevenue>
    <sport:ownershipModel>Member-owned (socio model)</sport:ownershipModel>
    <sport:homeStadium>Santiago Bernabéu (83,186 capacity)</sport:homeStadium>
    <sport:philosophy>Winning culture, star signings, attacking football</sport:philosophy>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/sports-ontology#SerieAOrg">
    <rdf:type rdf:resource="http://example.org/sports-ontology#League_Org" />
    <sport:organizationName>Lega Serie A</sport:organizationName>
    <sport:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1929</sport:establishedYear>
    <sport:headquarters>Milan, Italy</sport:headquarters>
    <sport:president>Lorenzo Casini</sport:president>
    <sport:memberCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</sport:memberCount>
    <sport:description>Lega Serie A governs Italy's top football division. Italian football's tactical sophistication and defensive excellence influenced the global game. Serie A is rebuilding its prominence after dominating European football in the 1990s.</sport:description>
    <sport:jurisdiction>Italy</sport:jurisdiction>
    <sport:annualRevenue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2800.0</sport:annualRevenue>
    <sport:manages>Serie A</sport:manages>
  </rdf:Description>
