  <rdf:Description rdf:about="http://example.org/sports-ontology#SuperBowl">
    <rdf:type rdf:resource="http://example.org/sports-ontology#Championship" />
    <sport:competitionName>Super Bowl LIX</sport:competitionName>
    <sport:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-09</sport:startDate>
    <sport:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-09</sport:endDate>
    <sport:numberOfTeams rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sport:numberOfTeams>
    <sport:season>2024</sport:season>
    <sport:prizeMoney rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.0</sport:prizeMoney>
    <sport:country>United States</sport:country>
    <sport:foundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1967</sport:foundedYear>
    <sport:description>The NFL's championship game and America's biggest sporting event. The Super Bowl is more than football—it's a cultural phenomenon with legendary halftime shows and iconic commercials. Over 100 million viewers tune in annually.</sport:description>
    <sport:broadcastCountries rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">185</sport:broadcastCountries>
    <sport:competitionFormat>Single championship game</sport:competitionFormat>
    <sport:venue>Caesars Superdome, New Orleans</sport:venue>
  </rdf:Description>
